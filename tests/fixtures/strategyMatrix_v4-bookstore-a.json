  "cellNotes": {
    "中文書籍|A": {
      "text": "種類多、價格低，並附豐富的書籍資訊，產品線以廣度與低價為特色 [S 354]",
      "vi": "",
      "bases": []
    },
    "資訊系統|A": {
      "text": "資訊系統支援書籍資料、顧客資料、倉儲存貨與運輸調度，也是網站好用與形象的基礎 [S 356]",
      "vi": "",
      "bases": []
    },
    "中文書籍|B": {
      "text": "目標客群是分散各地、所得與知識水準較高的上網人士，書籍與資訊的呈現方式要配合他們 [S 354]",
      "vi": "",
      "bases": []
    },
    "資訊系統|C": {
      "text": "自行發展，因為資訊系統是 A 公司特色的來源，不適合外包 [S 357]",
      "vi": "make",
      "bases": []
    },
    "物流運輸|C": {
      "text": "運輸需要規模經濟又要分散各地，不宜自行處理，找合適的合作業者承擔 [S 357]",
      "vi": "buy",
      "bases": []
    },
    "採購|D": {
      "text": "採購規模大、成本比較低，談判力來自市場需求與涵蓋地區夠大 [S 356]",
      "vi": "",
      "bases": []
    },
    "倉儲|E": {
      "text": "倉儲與運輸需分散在各地，服務分散各地的顧客 [S 354、357]",
      "vi": "",
      "bases": []
    },
    "資訊系統|F": {
      "text": "優勢來自經營團隊的技術能力，規模變大後更有利，也是網站形象與服務特色的來源 [S 356]",
      "vi": "",
      "bases": [
        "能力",
        "資訊科技"
      ]
    }
  },
