  "cellNotes": {
    "製程研發|A": {
      "text": "以製程領先為主要特色，持續改善良率與品質，並支援先進製程的開發 [S 361–362]",
      "vi": "",
      "bases": []
    },
    "先進製程代工|B": {
      "text": "主要客戶是 IC 設計業者；IC 的成敗主導權責在設計端，所以以他們為目標市場 [S 362]",
      "vi": "",
      "bases": []
    },
    "晶圓製造|C": {
      "text": "自有晶圓廠，專注 IC 製造這個環節，不碰下游封裝與自有品牌 [S 362]",
      "vi": "make",
      "bases": []
    },
    "設備|C": {
      "text": "生產設備多由國外先進廠商供應，自己不製造設備，向外採購 [S 361]",
      "vi": "buy",
      "bases": []
    },
    "晶圓製造|D": {
      "text": "規模大，成本有相對利益，排程與交期也較有彈性 [S 362]",
      "vi": "",
      "bases": []
    },
    "廠房產能|E": {
      "text": "位於台灣，產能集中在單一地區，地理環境與互補產業的支援是重點 [S 362–363]",
      "vi": "",
      "bases": []
    },
    "製程研發|F": {
      "text": "製程研發能力好，對晶圓品質與成本都有貢獻，是主要競爭優勢 [S 362]",
      "vi": "",
      "bases": [
        "能力",
        "時機"
      ]
    }
  },
